{% extends "Shared/template.html.twig" %}

{% block title %}Radicados{% endblock %}
{% block content %}
    <div class="render_wrap">
        <h3 class="mb-5">Radicados</h3>
        <div class="filters">
            <form action="">
                <div class="row mb-4">
                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Numero de radicado">
                    </div>

                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Nombre">
                    </div>

                    <div class="form-group col-4">
                        <input type="phone" class="form-control" placeholder="Telefono">
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Radicado padre">
                    </div>

                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Codigo de guia">
                    </div>

                    <div class="form-group col-4">
                        <input type="date" class="form-control" placeholder="Fecha de creación">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mb-4 col-2">Filtrar</button>
            </form>
        </div>
        {% if page <= totalPages %}
            <div class="table-responsive">
                <table class="table table-bordered">
                <thead class="table-dark">
                <tr>
                    <th scope="col">Nº Radicado</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Teléfono</th>
                    <th scope="col">Radicado Padre</th>
                    <th scope="col">Codigo de guia</th>
                    <th scope="col">Fecha de creación</th>
                </tr>
                </thead>
                <tbody>
                {% for file in filed  %}
                    <tr>
                        <th scope="row">{{ file.getNumRadicado() }}</th>
                        <td>{{ file.getNombreCompleto() }}</td>
                        <td>{{ file.getTelefono() }}</td>
                        <td>{{ file.getRadicadoCasoPadre() }}</td>
                        <td>{{ file.getCodigoGuia() }}</td>
                        <td>{{ file.getCreatedAt() }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% include 'Shared/paginator.html.twig' with {'totalPages': totalPages, 'page':  page, 'route': 'filed'} %}
            </div>
        {% else %}
            <h6>No hay data</h6>
        {% endif %}
    </div>
{% endblock %}
