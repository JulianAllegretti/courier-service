<!DOCTYPE html>
<html>
    <head>
        {% block head %}
            <link rel="stylesheet" href="/css/bootstrap.min.css"/>
            <link rel="stylesheet" href="/css/main.css"/>
            <script src="/js/bootstrap.bundle.min.js"></script>
            <title>{% block title %}{% endblock %} - Prindel App</title>
        {% endblock %}
    </head>
    <body>
        <div class="main">
            {% for type, messages in { 'success': 'alert-success', 'error': 'alert-danger', 'warning': 'alert-warning' } %}
                {% for message in app.flashes(type) %}
                    <div class="alert {{ messages }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block content %}{% endblock %}
        </div>
    </body>
</html>