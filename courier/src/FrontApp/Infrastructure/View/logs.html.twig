{% extends "Shared/template.html.twig" %}
{% use 'Shared/clearFilter.html.twig' %}

{% block title %}Radicados{% endblock %}
{% block content %}
    <div class="render_wrap">
        <h3>Log de inserción de radicados</h3>
        <div class="filters">
            <form action="{% if type != 'documents' %}/logs{% else %}/logs-documents{% endif %}">
                <div class="row mb-4">
                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Id Radicado" name="id_radicado" value="{{ params['id_radicado'] ?? ''}}">
                    </div>

                    <div class="form-group col-4">
                        <input type="text" class="form-control" placeholder="Error" name="error" value="{{ params['error'] ?? ''}}">
                    </div>

                    <div class="form-group col-4">
                        <input type="date" class="form-control" placeholder="Fecha de creación" name="created_at" value="{{ params['created_at'] ?? ''}}">
                    </div>
                </div>
                <div class="row mb-4">
                    {% if type == 'documents' %}
                        <div class="form-group col-4">
                            <input type="text" class="form-control" placeholder="Id Documento" name="id_documento" value="{{ params['id_documento'] ?? ''}}">
                        </div>
                    {% endif %}
                </div>
                <button type="submit" class="btn btn-primary mb-4 col-2">Filtrar</button>
                <button id="clearFilters" type="button" class="btn btn-secondary mb-4 col-2" value="reset">Limpiar filtros</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead class="table-dark">
                <tr>
                    <th scope="col">Id Radicado</th>
                    {% if type == 'documents' %}
                        <th scope="col">Id Documento</th>
                    {% endif %}
                    <th scope="col">Error</th>
                    <th scope="col">Codigo</th>
                    <th scope="col">Fecha de creación</th>
                </tr>
                </thead>
                <tbody>
                {% for log in logs  %}
                    <tr>
                        <th scope="row">{{ log.numero_radicado }}</th>
                        {% if type == 'documents' %}
                            <td>{{ log.id_documento }}</td>
                        {% endif %}
                        <td>{{ log.error_message }}</td>
                        <td>{{ log.error_code }}</td>
                        <td>{{ log.created_at }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% include 'Shared/paginator.html.twig' with {'totalPages': totalPages, 'page':  page, 'route': type != 'documents' ? 'logs' : 'logs-documents'} %}
        </div>
    </div>
    {% block clear_filters %}{{ parent() }}{% endblock %}
{% endblock %}
